# NISS dashboard - process environment (NOT baked into the build).
#
# Port the dashboard listens on (next dev / next start). Default 3000.
# NOTE: Next.js reads PORT from the real process environment, not from .env files.
#   PowerShell:  $env:PORT = "3000"; npm start
#   cmd.exe:     set PORT=3000 && npm start
#   bash:        PORT=3000 npm start
#   or:          npx next start -H 0.0.0.0 -p 3000
PORT=3000

# The API address is NOT configured here. It is resolved in the browser at runtime from
# public/runtime-config.json  ->  { "apiBaseUrl": "https://central-pc:8443" }
# (empty string = automatic: https://<the host you opened the dashboard on>:8443).
# Editing that file takes effect on the next page load - no rebuild needed.
